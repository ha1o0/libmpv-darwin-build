+// Read the selected stream and its already-decoded metadata. This property
+// never opens another input, decodes a frame or changes output configuration.
+static int mp_property_video_dolby_vision(void *ctx, struct m_property *prop,
+                                         int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    int valid = m_property_read_sub_validate(ctx, prop, action, arg);
+    if (valid != M_PROPERTY_VALID)
+        return valid;
+    struct track *track = mpctx->current_track[0][STREAM_VIDEO];
+    if (!track || !track->stream || !track->stream->codec)
+        return M_PROPERTY_UNAVAILABLE;
+    struct mp_codec_params *codec = track->stream->codec;
+    const AVCodecParameters *lav = codec->lav_codecpar;
+    const AVPacketSideData *side = lav
+        ? av_packet_side_data_get(lav->coded_side_data, lav->nb_coded_side_data,
+                                  AV_PKT_DATA_DOVI_CONF) : NULL;
+    const AVDOVIDecoderConfigurationRecord *config =
+        side && side->size >= sizeof(*config) ? (const void *)side->data : NULL;
+    if (!config && !codec->dovi)
+        return M_PROPERTY_UNAVAILABLE;
+    const int profile = config ? config->dv_profile : codec->dv_profile;
+    const char *enhancement = NULL;
+    if (profile == 7 && config && config->el_present_flag &&
+        mpctx->video_out && mpctx->vo_chain && mpctx->vo_chain->track == track) {
+        struct mp_image *frame = vo_get_current_frame(mpctx->video_out);
+        if (frame) {
+            for (int n = 0; n < frame->num_ff_side_data; n++) {
+                struct mp_ff_side_data *data = &frame->ff_side_data[n];
+                if (data->type == AV_FRAME_DATA_DOVI_METADATA && data->buf) {
+                    enhancement = mp_dovi_enhancement_layer(data->buf->data,
+                                                           data->buf->size);
+                    break;
+                }
+            }
+            talloc_free(frame);
+        }
+    }
+    struct m_sub_property props[] = {
+        {"track-id", SUB_PROP_INT(track->user_tid)},
+        {"profile", SUB_PROP_INT(profile)},
+        {"level", SUB_PROP_INT(config ? config->dv_level : codec->dv_level)},
+        {"compatibility-id", SUB_PROP_INT(config ? config->dv_bl_signal_compatibility_id : 0),
+                             .unavailable = !config},
+        {"rpu-present", SUB_PROP_BOOL(config && config->rpu_present_flag), .unavailable = !config},
+        {"base-layer-present", SUB_PROP_BOOL(config && config->bl_present_flag), .unavailable = !config},
+        {"enhancement-layer-present", SUB_PROP_BOOL(config && config->el_present_flag), .unavailable = !config},
+        {"enhancement-layer", SUB_PROP_STR(enhancement), .unavailable = !enhancement},
+        {0}
+    };
+    return m_property_read_sub(props, action, arg);
+}
