diff --git a/video/dovi_source_spec.h b/video/dovi_source_spec.h
new file mode 100644
index 0000000..72bf0dd
--- /dev/null
+++ b/video/dovi_source_spec.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+#include <libavutil/dovi_meta.h>
+
+// Inspect parsed FFmpeg RPU side data without changing it. An EL presence
+// flag alone cannot distinguish MEL from FEL. MEL has a zero residual NLQ
+// for all components; unsupported or incomplete metadata stays unknown.
+static inline const char *mp_dovi_enhancement_layer(const uint8_t *bytes, size_t size)
+{
+    if (!bytes || size < sizeof(AVDOVIMetadata))
+        return NULL;
+    AVDOVIMetadata metadata;
+    memcpy(&metadata, bytes, sizeof(metadata));
+    if (metadata.header_offset < sizeof(metadata) ||
+        metadata.mapping_offset < sizeof(metadata) ||
+        metadata.header_offset > size || metadata.mapping_offset > size ||
+        size - metadata.header_offset < sizeof(AVDOVIRpuDataHeader) ||
+        size - metadata.mapping_offset < sizeof(AVDOVIDataMapping))
+        return NULL;
+    AVDOVIRpuDataHeader header;
+    AVDOVIDataMapping mapping;
+    memcpy(&header, bytes + metadata.header_offset, sizeof(header));
+    memcpy(&mapping, bytes + metadata.mapping_offset, sizeof(mapping));
+    if (header.disable_residual_flag || header.coef_log2_denom > 32 ||
+        mapping.nlq_method_idc != AV_DOVI_NLQ_LINEAR_DZ)
+        return NULL;
+    const uint64_t one = UINT64_C(1) << header.coef_log2_denom;
+    for (int c = 0; c < 3; c++) {
+        const AVDOVINLQParams *nlq = &mapping.nlq[c];
+        if (nlq->nlq_offset != 0 || nlq->vdr_in_max != one ||
+            nlq->linear_deadzone_slope != 0 || nlq->linear_deadzone_threshold != 0)
+            return "FEL";
+    }
+    return "MEL";
+}
