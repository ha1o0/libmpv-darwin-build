+
+// The libmpv gpu-next API does not pass through vo_gpu_next's hook loader.
+// Keep only the active chain: cycling Anime4K presets must not retain every
+// previously parsed shader or its textures on memory-constrained devices.
+static void destroy_shader_hooks(const struct pl_hook ***hooks, int count)
+{
+    for (int i = 0; i < count; i++)
+        pl_mpv_user_shader_destroy(&(*hooks)[i]);
+    talloc_free(*hooks);
+    *hooks = NULL;
+}
+
+static void update_shader_hooks(struct pl_video *p, struct pl_render_params *params)
+{
+    m_config_cache_update(p->opts_cache);
+    const struct gl_video_opts *opts = p->opts_cache->opts;
+    int count = 0;
+    bool changed = false;
+    for (; opts->user_shaders && opts->user_shaders[count]; count++) {
+        if (!p->shader_paths || !p->shader_paths[count] ||
+            strcmp(opts->user_shaders[count], p->shader_paths[count])) {
+            changed = true;
+            break;
+        }
+    }
+    if (!changed && p->shader_paths && p->shader_paths[count])
+        changed = true;
+    if (changed) {
+        count = 0;
+        while (opts->user_shaders && opts->user_shaders[count]) count++;
+        talloc_free(p->shader_paths);
+        p->shader_paths = talloc_zero_array(p, char *, count + 1);
+        const struct pl_hook **hooks = talloc_zero_array(p, const struct pl_hook *, count);
+        bool valid = true;
+        for (int i = 0; i < count; i++) {
+            p->shader_paths[i] = talloc_strdup(p->shader_paths, opts->user_shaders[i]);
+            char *path = mp_get_user_path(NULL, p->global, opts->user_shaders[i]);
+            bstr code = stream_read_file(path, NULL, p->global, 16 * 1024 * 1024);
+            if (code.len)
+                hooks[i] = pl_mpv_user_shader_parse(p->ra->gpu, code.start, code.len);
+            talloc_free(code.start);
+            talloc_free(path);
+            valid &= hooks[i] != NULL;
+        }
+        if (valid) {
+            // Retained paused frames must be redrawn with the new chain.
+            pl_gpu_finish(p->ra->gpu);
+            ra_pl_reset(p->ra);
+            destroy_shader_hooks(&p->shader_hooks, p->num_shader_hooks);
+            p->shader_hooks = hooks;
+            p->num_shader_hooks = count;
+            mp_msg(p->log, MSGL_V, "Applied %d user shader hooks.\n", count);
+        } else {
+            destroy_shader_hooks(&hooks, count);
+            mp_msg(p->log, MSGL_ERR, "Unable to load user shader chain; keeping previous hooks.\n");
+        }
+    }
+    params->hooks = p->shader_hooks;
+    params->num_hooks = p->num_shader_hooks;
+}
 
