--- a/include/mpv/render.h
+++ b/include/mpv/render.h
@@ -444,6 +444,13 @@ typedef enum mpv_render_param_type {
      * Type: mpv_d3d11_fbo*
      */
     MPV_RENDER_PARAM_D3D11_FBO = 23,
+    /**
+     * A nonplanar 32BGRA IOSurface render target (iOS gpu-next only).
+     * Valid for mpv_render_context_render(). Type: IOSurfaceRef, passed
+     * directly in data, not a pointer to the IOSurfaceRef. GPU writes are
+     * complete when mpv_render_context_render() returns.
+     */
+    MPV_RENDER_PARAM_IOSURFACE = 24,
 } mpv_render_param_type;

 /**
@@ -488,6 +495,7 @@ typedef struct mpv_render_param {
  */
 // See render_d3d11.h
 #define MPV_RENDER_API_TYPE_D3D11 "d3d11"
+#define MPV_RENDER_API_TYPE_IOSURFACE "iosurface"
 // See render_gl.h
 #define MPV_RENDER_API_TYPE_OPENGL "opengl"
 // See section "Software renderer"
diff --git a/video/out/gpu_next/context.c b/video/out/gpu_next/context.c
index 4923d72..9bc8305 100644
--- a/video/out/gpu_next/context.c
+++ b/video/out/gpu_next/context.c
@@ -575,3 +575,116 @@ const struct libmpv_gpu_next_context_fns libmpv_gpu_next_context_gl = {
     .destroy = libmpv_gpu_next_destroy_gl,
 };
 #endif
+
+#if HAVE_IOS_GL && HAVE_VULKAN && defined(PL_HAVE_VULKAN)
+#include <IOSurface/IOSurfaceRef.h>
+#include <libplacebo/vulkan.h>
+#include "video/out/placebo/ra_pl.h"
+
+struct iosurface_priv {
+    pl_log log;
+    pl_vk_inst instance;
+    pl_vulkan device;
+    pl_fmt format;
+};
+
+static void iosurface_destroy(struct libmpv_gpu_next_context *ctx)
+{
+    struct iosurface_priv *p = ctx->priv;
+    ra_pl_destroy(&ctx->ra);
+    if (ctx->ra_ctx && ctx->ra_ctx->ra) {
+        ctx->ra_ctx->ra->fns->destroy(ctx->ra_ctx->ra);
+        ctx->ra_ctx->ra = NULL;
+    }
+    pl_vulkan_destroy(&p->device);
+    pl_vk_inst_destroy(&p->instance);
+    pl_log_destroy(&p->log);
+}
+
+static int iosurface_init(struct libmpv_gpu_next_context *ctx, mpv_render_param *params)
+{
+    struct iosurface_priv *p = talloc_zero(ctx, struct iosurface_priv);
+    ctx->priv = p;
+    p->log = mppl_log_create(p, ctx->log);
+    p->instance = pl_vk_inst_create(p->log, pl_vk_inst_params(
+        .get_proc_addr = vkGetInstanceProcAddr,
+    ));
+    if (!p->instance)
+        goto fail;
+
+    p->device = pl_vulkan_create(p->log, pl_vulkan_params(
+        .instance = p->instance->instance,
+        .get_proc_addr = p->instance->get_proc_addr,
+    ));
+    if (!p->device)
+        goto fail;
+
+    ctx->gpu = p->device->gpu;
+    p->format = pl_find_named_fmt(ctx->gpu, "bgra8");
+    if (!(ctx->gpu->import_caps.tex & PL_HANDLE_IOSURFACE) ||
+        !p->format || !(p->format->caps & PL_FMT_CAP_RENDERABLE))
+        goto fail;
+
+    ctx->ra = ra_pl_create(ctx->gpu, ctx->log, p->log);
+    ctx->ra_ctx = talloc_zero(ctx, struct ra_ctx);
+    ctx->ra_ctx->global = ctx->global;
+    ctx->ra_ctx->log = ctx->log;
+    ctx->ra_ctx->ra = ra_create_pl(ctx->gpu, ctx->log);
+    if (!ctx->ra || !ctx->ra_ctx->ra)
+        goto fail;
+
+    return 0;
+
+fail:
+    MP_ERR(ctx, "Unable to initialize MoltenVK IOSurface rendering.\n");
+    iosurface_destroy(ctx);
+    return MPV_ERROR_UNSUPPORTED;
+}
+
+static int iosurface_size(mpv_render_param *params, int *w, int *h)
+{
+    IOSurfaceRef surface = get_mpv_render_param(params, MPV_RENDER_PARAM_IOSURFACE, NULL);
+    if (!surface || IOSurfaceGetPixelFormat(surface) != 0x42475241 || // 'BGRA'
+        IOSurfaceGetPlaneCount(surface) || !IOSurfaceGetWidth(surface) ||
+        !IOSurfaceGetHeight(surface) || IOSurfaceGetWidth(surface) > INT32_MAX ||
+        IOSurfaceGetHeight(surface) > INT32_MAX)
+        return MPV_ERROR_INVALID_PARAMETER;
+    *w = IOSurfaceGetWidth(surface);
+    *h = IOSurfaceGetHeight(surface);
+    return 0;
+}
+
+static int iosurface_wrap(struct libmpv_gpu_next_context *ctx,
+                          mpv_render_param *params, pl_tex *out)
+{
+    struct iosurface_priv *p = ctx->priv;
+    int w, h;
+    int err = iosurface_size(params, &w, &h);
+    if (err < 0)
+        return err;
+    IOSurfaceRef surface = get_mpv_render_param(params, MPV_RENDER_PARAM_IOSURFACE, NULL);
+    *out = pl_tex_create(ctx->gpu, pl_tex_params(
+        .w = w, .h = h, .format = p->format, .renderable = true, .blit_dst = true,
+        .import_handle = PL_HANDLE_IOSURFACE,
+        .shared_mem.handle.handle = (void *) surface,
+        .shared_mem.size = IOSurfaceGetAllocSize(surface),
+    ));
+    return *out ? 0 : MPV_ERROR_GENERIC;
+}
+
+static void iosurface_done(struct libmpv_gpu_next_context *ctx)
+{
+    // Flutter and AVKit can use different Metal command queues. Complete the
+    // write before publishing this shared surface to either consumer.
+    pl_gpu_finish(ctx->gpu);
+}
+
+const struct libmpv_gpu_next_context_fns libmpv_gpu_next_context_iosurface = {
+    .api_name = MPV_RENDER_API_TYPE_IOSURFACE,
+    .init = iosurface_init,
+    .wrap_fbo = iosurface_wrap,
+    .target_size = iosurface_size,
+    .done_frame = iosurface_done,
+    .destroy = iosurface_destroy,
+};
+#endif
