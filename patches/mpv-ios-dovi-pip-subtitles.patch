+// Sample normalized source components without copying a source-sized frame.
+// Only the bounded PiP output is processed; decoded VideoToolbox buffers stay
+// read-only and all GPU state is untouched while the app is inactive.
+static float pip_component(const struct mp_image *image, const AVPixFmtDescriptor *desc,
+                            int component, float x, float y)
+{
+    AVComponentDescriptor c = desc->comp[component];
+    int xs = component ? desc->log2_chroma_w : 0;
+    int ys = component ? desc->log2_chroma_h : 0;
+    int w = (image->w + (1 << xs) - 1) >> xs;
+    int h = (image->h + (1 << ys) - 1) >> ys;
+    float ox = 0, oy = 0;
+    if (component) pl_chroma_location_offset(image->params.chroma_location, &ox, &oy);
+    x = dv_clamp((x - ox + .5f) / (1 << xs) - .5f, 0, w - 1);
+    y = dv_clamp((y - oy + .5f) / (1 << ys) - .5f, 0, h - 1);
+    int x0 = floorf(x), y0 = floorf(y);
+    int x1 = MPMIN(x0 + 1, w - 1), y1 = MPMIN(y0 + 1, h - 1);
+    float result = 0;
+    for (int dy = 0; dy < 2; dy++) {
+        for (int dx = 0; dx < 2; dx++) {
+            const uint8_t *p = image->planes[c.plane] + (dy ? y1 : y0) * image->stride[c.plane]
+                + (dx ? x1 : x0) * c.step + c.offset;
+            unsigned v = p[0];
+            if (c.depth + c.shift > 8) v |= (unsigned)p[1] << 8;
+            v = (v >> c.shift) & ((1u << c.depth) - 1);
+            result += v * (dx ? x - x0 : 1 - (x - x0)) * (dy ? y - y0 : 1 - (y - y0));
+        }
+    }
+    return result / ((1u << c.depth) - 1);
+}
+
+static void draw_pip_dovi_osd(struct mpv_render_context *ctx, struct osd_state *osd,
+                              double pts, void *pixels, size_t stride, int w, int h)
+{
+    if (!osd) return;
+    struct sub_bitmap_list *list = osd_render(osd, ctx->pip_osd, pts, 0, mp_draw_sub_formats);
+    if (!list->num_items || list->w != w || list->h != h) { talloc_free(list); return; }
+    if (!ctx->pip_osd_cache) ctx->pip_osd_cache = mp_draw_sub_alloc(ctx, ctx->global);
+    struct mp_rect active[8], modified[8];
+    int na = 0, nm = 0;
+    struct mp_image *overlay = mp_draw_sub_overlay(ctx->pip_osd_cache, list,
+        active, MP_ARRAY_SIZE(active), &na, modified, MP_ARRAY_SIZE(modified), &nm);
+    if (overlay && overlay->w >= w && overlay->h >= h) {
+        // sRGB subtitle pixels -> linear BT.2020 at 203 nit reference white.
+        // Blend in linear light, then re-encode PQ. Preserve ten-bit gradients.
+        for (int n = 0; n < na; n++) {
+            struct mp_rect rc = active[n];
+            for (int y = MPMAX(rc.y0, 0); y < MPMIN(rc.y1, h); y++) {
+                for (int x = MPMAX(rc.x0, 0); x < MPMIN(rc.x1, w); x++) {
+                    const uint8_t *src = overlay->planes[0] + y * overlay->stride[0] + 4 * x;
+                    if (!src[3]) continue;
+                    uint32_t *dst = (uint32_t *)((uint8_t *)pixels + y * stride) + x;
+                    float a = src[3] / 255.0f, linear[3], rgb[3];
+                    for (int c = 0; c < 3; c++) {
+                        float v = dv_clamp(src[2 - c] / (float)src[3], 0, 1);
+                        linear[c] = v <= .04045f ? v / 12.92f : powf((v + .055f) / 1.055f, 2.4f);
+                    }
+                    const float bt2020[3][3] = {
+                        {.627404f, .329283f, .043313f},
+                        {.069097f, .919540f, .011362f},
+                        {.016391f, .088013f, .895595f},
+                    };
+                    for (int c = 0; c < 3; c++) {
+                        float sub = 0;
+                        for (int j = 0; j < 3; j++) sub += bt2020[c][j] * linear[j];
+                        float video = dv_pq_decode(((*dst >> ((2 - c) * 10)) & 1023) / 1023.0f);
+                        rgb[c] = dv_pq_encode(sub * (.0203f * a) + video * (1 - a));
+                    }
+                    *dst = dv_pip_pack(rgb);
+                }
+            }
+        }
+    }
+    talloc_free(list);
+}
+
+static int render_pip_dovi(struct mpv_render_context *ctx, const struct mp_image *image,
+                           void *pixels, size_t stride, int w, int h, struct osd_state *osd)
+{
+    if (!image->params.repr.dovi || image->params.repr.sys != PL_COLOR_SYSTEM_DOLBYVISION ||
+        image->params.rotate || image->params.vflip)
+        return MPV_ERROR_UNSUPPORTED;
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(imgfmt2pixfmt(image->imgfmt));
+    if (!desc || desc->nb_components != 3 || desc->flags &
+        (AV_PIX_FMT_FLAG_BE | AV_PIX_FMT_FLAG_RGB | AV_PIX_FMT_FLAG_FLOAT | AV_PIX_FMT_FLAG_HWACCEL))
+        return MPV_ERROR_UNSUPPORTED;
+    for (int c = 0; c < 3; c++) {
+        if (desc->comp[c].depth < 8 || desc->comp[c].depth > 16 ||
+            desc->comp[c].depth + desc->comp[c].shift > 16 || !image->planes[desc->comp[c].plane])
+            return MPV_ERROR_UNSUPPORTED;
+    }
+    struct pl_color_repr repr = image->params.repr;
+    repr.bits = (struct pl_bit_encoding) {
+        .sample_depth = desc->comp[0].depth + desc->comp[0].shift > 8 ? 16 : 8,
+        .color_depth = desc->comp[0].depth, .bit_shift = desc->comp[0].shift,
+    };
+    struct dv_pip_transform transform;
+    if (!dv_pip_prepare(&transform, repr)) return MPV_ERROR_UNSUPPORTED;
+    for (int y = 0; y < h; y++) {
+        uint32_t *out = (uint32_t *)((uint8_t *)pixels + y * stride);
+        float sy = (y + .5f) * image->h / h - .5f;
+        for (int x = 0; x < w; x++) {
+            float sx = (x + .5f) * image->w / w - .5f;
+            float input[3], rgb[3];
+            for (int c = 0; c < 3; c++) input[c] = pip_component(image, desc, c, sx, sy);
+            dv_pip_color(&transform, input, rgb);
+            out[x] = dv_pip_pack(rgb);
+        }
+    }
+    ctx->pip_osd = (struct mp_osd_res){.w = w, .h = h, .display_par = 1};
+    draw_pip_dovi_osd(ctx, osd, image->pts, pixels, stride, w, h);
+    return 0;
+}
