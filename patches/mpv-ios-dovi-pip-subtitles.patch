new file mode 100644
index 0000000..0694da7
--- /dev/null
+++ b/video/out/ios_dovi_pip.h
@@ -0,0 +1,118 @@
+// iOS-only CPU equivalent of libplacebo 7.360.1's Dolby color decoding.
+// Reshaping and matrices follow src/shaders/colorspace.c. No display mapping
+// or fake RPU is applied to the resulting BT.2020/PQ pixels.
+#pragma once
+#include <math.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <libplacebo/colorspace.h>
+
+static inline float dv_clamp(float v, float lo, float hi)
+{
+    return fminf(hi, fmaxf(lo, v));
+}
+
+static inline float dv_pq_decode(float v)
+{
+    float p = powf(dv_clamp(v, 0, 1), 32.0f / 2523.0f);
+    return powf(fmaxf(p - 3424.0f / 4096.0f, 0) /
+                (2413.0f / 128.0f - 2392.0f / 128.0f * p), 16384.0f / 2610.0f);
+}
+
+static inline float dv_pq_encode(float v)
+{
+    float p = powf(dv_clamp(v, 0, 1), 2610.0f / 16384.0f);
+    return powf((3424.0f / 4096.0f + 2413.0f / 128.0f * p) /
+                (1 + 2392.0f / 128.0f * p), 2523.0f / 32.0f);
+}
+
+struct dv_pip_transform {
+    const struct pl_dovi_metadata *metadata;
+    pl_transform3x3 nonlinear;
+    pl_matrix3x3 linear;
+};
+
+static inline bool dv_pip_prepare(struct dv_pip_transform *out,
+                                  struct pl_color_repr repr)
+{
+    const struct pl_dovi_metadata *d = repr.dovi;
+    if (repr.sys != PL_COLOR_SYSTEM_DOLBYVISION || !d)
+        return false;
+    for (int c = 0; c < 3; c++) {
+        const struct pl_reshape_data *curve = &d->comp[c];
+        if (curve->num_pivots == 1 || curve->num_pivots > 9)
+            return false;
+        for (int i = 0; i < curve->num_pivots; i++) {
+            if (!isfinite(curve->pivots[i]) || curve->pivots[i] < 0 ||
+                curve->pivots[i] > 1 || (i && curve->pivots[i] <= curve->pivots[i - 1]))
+                return false;
+        }
+        for (int i = 0; i + 1 < curve->num_pivots; i++) {
+            if (curve->method[i] > 1 || (curve->method[i] == 1 &&
+                (curve->mmr_order[i] < 1 || curve->mmr_order[i] > 3)))
+                return false;
+        }
+    }
+    // Samples supplied below are already normalized to their coded depth.
+    // Retain storage depth for exactly the same RPU offset normalization as
+    // the GPU path after pl_color_repr_normalize.
+    pl_color_repr_normalize(&repr);
+    out->metadata = d;
+    out->nonlinear = pl_color_repr_decode(&repr, NULL);
+    out->linear = (pl_matrix3x3){{
+        {3.06441879f, -2.16597676f, 0.10155818f},
+        {-0.65612108f, 1.78554118f, -0.12943749f},
+        {0.01736321f, -0.04725154f, 1.03004253f},
+    }};
+    pl_matrix3x3_mul(&out->linear, &d->linear);
+    return true;
+}
+
+static inline void dv_pip_color(const struct dv_pip_transform *tr,
+                                const float input[3], float rgb[3])
+{
+    float sig[3], reshaped[3];
+    for (int c = 0; c < 3; c++) sig[c] = dv_clamp(input[c], 0, 1);
+    for (int c = 0; c < 3; c++) {
+        const struct pl_reshape_data *curve = &tr->metadata->comp[c];
+        float s = sig[c];
+        if (!curve->num_pivots) { reshaped[c] = s; continue; }
+        int i = 0;
+        while (i + 2 < curve->num_pivots && s >= curve->pivots[i + 1]) i++;
+        if (curve->method[i] == 0) {
+            const float *p = curve->poly_coeffs[i];
+            s = (p[2] * s + p[1]) * s + p[0];
+        } else {
+            float terms[7] = {sig[0], sig[1], sig[2], sig[0] * sig[1],
+                sig[0] * sig[2], sig[1] * sig[2], sig[0] * sig[1] * sig[2]};
+            float power[7];
+            for (int k = 0; k < 7; k++) power[k] = terms[k];
+            s = curve->mmr_constant[i];
+            for (int order = 0; order < curve->mmr_order[i]; order++) {
+                for (int k = 0; k < 7; k++) {
+                    s += curve->mmr_coeffs[i][order][k] * power[k];
+                    power[k] *= terms[k];
+                }
+            }
+        }
+        reshaped[c] = dv_clamp(s, curve->pivots[0], curve->pivots[curve->num_pivots - 1]);
+    }
+    float lms[3];
+    for (int c = 0; c < 3; c++) {
+        float v = tr->nonlinear.c[c];
+        for (int j = 0; j < 3; j++) v += tr->nonlinear.mat.m[c][j] * reshaped[j];
+        lms[c] = dv_pq_decode(v);
+    }
+    for (int c = 0; c < 3; c++) {
+        float v = 0;
+        for (int j = 0; j < 3; j++) v += tr->linear.m[c][j] * lms[j];
+        rgb[c] = dv_pq_encode(v);
+    }
+}
+
+static inline uint32_t dv_pip_pack(const float rgb[3])
+{
+    return (uint32_t)lrintf(dv_clamp(rgb[2], 0, 1) * 1023) |
+        ((uint32_t)lrintf(dv_clamp(rgb[1], 0, 1) * 1023) << 10) |
+        ((uint32_t)lrintf(dv_clamp(rgb[0], 0, 1) * 1023) << 20) | 0xc0000000u;
+}
