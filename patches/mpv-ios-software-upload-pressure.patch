  * @param frame The destination `pl_frame` to be populated with GPU texture info.
  * @return True on success, false on failure.
  */
+// Only a failed upload activates this fallback. Keep high-bit-depth YUV and
+// color/RPU side data for the ordinary GPU compositor; do not tag SDR as HDR.
+static struct mp_image *fit_software_upload(struct pl_video *p, struct mp_image *src)
+{
+#if HAVE_IOS_GL && HAVE_VULKAN && defined(PL_HAVE_VULKAN)
+    if (!p->ra_ctx || ra_pl_get(p->ra_ctx->ra) != p->ra->gpu ||
+        (int64_t)src->w * src->h <= 1920 * 1080 ||
+        !mp_sws_supported_format(src->imgfmt))
+        return NULL;
+    double scale = sqrt((1920.0 * 1080) / ((double)src->w * src->h));
+    int w = MPMAX(2, ((int)(src->w * scale)) & ~1);
+    int h = MPMAX(2, ((int)(src->h * scale)) & ~1);
+    if (!p->sw_upload_pool) p->sw_upload_pool = mp_image_pool_new(p);
+    if (!p->sw_upload_scaler) {
+        p->sw_upload_scaler = mp_sws_alloc(p);
+        p->sw_upload_scaler->log = p->log;
+        p->sw_upload_scaler->flags = mp_sws_fast_flags;
+        p->sw_upload_scaler->force_scaler = MP_SWS_SWS;
+    }
+    struct mp_image *dst = mp_image_pool_get(p->sw_upload_pool, src->imgfmt, w, h);
+    if (!dst) return NULL;
+    mp_image_copy_attributes(dst, src);
+    struct mp_rect crop = src->params.crop;
+    dst->params.crop = (struct mp_rect) {
+        .x0 = (int)((int64_t)crop.x0 * w / src->w),
+        .y0 = (int)((int64_t)crop.y0 * h / src->h),
+        .x1 = (int)((int64_t)crop.x1 * w / src->w),
+        .y1 = (int)((int64_t)crop.y1 * h / src->h),
+    };
+    if (mp_sws_scale(p->sw_upload_scaler, dst, src) < 0) {
+        talloc_free(dst);
+        return NULL;
+    }
+    return dst;
+#else
+    return NULL;
+#endif
+}
