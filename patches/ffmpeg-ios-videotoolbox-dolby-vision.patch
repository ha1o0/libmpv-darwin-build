+/**
+ * Single-layer Dolby Vision HEVC (profiles 5 and 8) as signalled by the
+ * container. VideoToolbox only propagates the per-frame RPU to its output
+ * buffers (the "DolbyVisionRPUData" attachment) when the session is created
+ * as 'dvh1' with a dvcC/dvvC record; as 'hvc1' it silently drops the RPU.
+ * Dual-layer profile 7 stays on the HDR10 base layer.
+ */
+static const AVDOVIDecoderConfigurationRecord *videotoolbox_dovi_config(AVCodecContext *avctx)
+{
+    const AVPacketSideData *sd;
+    const AVDOVIDecoderConfigurationRecord *dovi;
+
+    if (avctx->codec_id != AV_CODEC_ID_HEVC)
+        return NULL;
+    sd = av_packet_side_data_get(avctx->coded_side_data, avctx->nb_coded_side_data,
+                                 AV_PKT_DATA_DOVI_CONF);
+    if (!sd || sd->size < sizeof(*dovi))
+        return NULL;
+    dovi = (const AVDOVIDecoderConfigurationRecord *)sd->data;
+    if (!dovi->rpu_present_flag || !dovi->bl_present_flag || dovi->el_present_flag)
+        return NULL;
+    if (dovi->dv_profile != 5 && dovi->dv_profile != 8)
+        return NULL;
+    return dovi;
+}
+
+/** ISO/IEC 14496-15 style DOVIDecoderConfigurationRecord (24 bytes). */
+static CFDataRef videotoolbox_dovi_record_create(const AVDOVIDecoderConfigurationRecord *dovi)
+{
+    uint8_t buf[24] = { 0 };
+    buf[0] = dovi->dv_version_major;
+    buf[1] = dovi->dv_version_minor;
+    buf[2] = (dovi->dv_profile << 1) | ((dovi->dv_level >> 5) & 0x01);
+    buf[3] = ((dovi->dv_level & 0x1f) << 3) |
+             (dovi->rpu_present_flag << 2) |
+             (dovi->el_present_flag << 1) |
+             dovi->bl_present_flag;
+    buf[4] = (dovi->dv_bl_signal_compatibility_id << 4) |
+             ((dovi->dv_md_compression & 0x03) << 2);
+    return CFDataCreate(kCFAllocatorDefault, buf, sizeof(buf));
+}
