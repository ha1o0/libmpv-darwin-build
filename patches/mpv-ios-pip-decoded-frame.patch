+#if HAVE_IOS_GL && HAVE_VULKAN
+// The view and its base addresses live only while the source vo_frame is
+// retained and the CVPixelBuffer is locked. No second 4K frame is allocated.
+static int map_pip_image(struct mp_image *source, struct mp_image *view,
+                         CVPixelBufferRef *locked)
+{
+    *view = *source;
+    *locked = NULL;
+    if (!IMGFMT_IS_HWACCEL(source->imgfmt))
+        return 0;
+    if (source->imgfmt != IMGFMT_VIDEOTOOLBOX || !source->planes[3])
+        return MPV_ERROR_UNSUPPORTED;
+    CVPixelBufferRef pixel = (CVPixelBufferRef)source->planes[3];
+    int format;
+    switch (CVPixelBufferGetPixelFormatType(pixel)) {
+    case kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange:
+    case kCVPixelFormatType_420YpCbCr8BiPlanarFullRange:
+        format = IMGFMT_NV12;
+        break;
+    case kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange:
+    case kCVPixelFormatType_420YpCbCr10BiPlanarFullRange:
+        format = IMGFMT_P010;
+        break;
+    case kCVPixelFormatType_32BGRA:
+        format = IMGFMT_BGRA;
+        break;
+    default:
+        return MPV_ERROR_UNSUPPORTED;
+    }
+    if (source->w > CVPixelBufferGetWidth(pixel) ||
+        source->h > CVPixelBufferGetHeight(pixel) ||
+        CVPixelBufferLockBaseAddress(pixel, kCVPixelBufferLock_ReadOnly))
+        return MPV_ERROR_UNSUPPORTED;
+    *locked = pixel;
+    mp_image_setfmt(view, format);
+    view->params.hw_subfmt = 0;
+    for (int n = 0; n < view->num_planes; n++) {
+        bool planar = CVPixelBufferIsPlanar(pixel);
+        view->planes[n] = planar ? CVPixelBufferGetBaseAddressOfPlane(pixel, n)
+                                 : CVPixelBufferGetBaseAddress(pixel);
+        size_t stride = planar ? CVPixelBufferGetBytesPerRowOfPlane(pixel, n)
+                                : CVPixelBufferGetBytesPerRow(pixel);
+        if (!view->planes[n] || stride > INT_MAX)
+            return MPV_ERROR_UNSUPPORTED;
+        view->stride[n] = stride;
+    }
+    return 0;
+}
+
+// The software path keeps an HDR frame's PQ/HLG code values: it only applies
+// the YCbCr matrix. Subtitle bitmaps are sRGB, so blending their code values
+// unchanged would encode white text as the format's peak (10000 nits for PQ).
+// Map them to the frame's transfer at HDR reference white instead.
+static void init_pip_osd_lut(struct mpv_render_context *ctx,
+                             enum pl_color_transfer trc)
+{
+    if (ctx->pip_osd_lut_trc == trc)
+        return;
+    ctx->pip_osd_lut_trc = trc;
+    for (int i = 0; i < 256; i++) {
+        float v = i / 255.0f;
+        float linear = v <= 0.04045f ? v / 12.92f
+                                     : powf((v + 0.055f) / 1.055f, 2.4f);
+        float out;
+        if (trc == PL_COLOR_TRC_PQ) {
+            // SDR white at 203 nits (ITU-R BT.2408) on the 10000 nit PQ scale.
+            float y = linear * 203.0f / 10000.0f;
+            float p = powf(y, 2610.0f / 16384.0f);
+            out = powf((3424.0f / 4096.0f + 2413.0f / 128.0f * p) /
+                       (1.0f + 2392.0f / 128.0f * p), 2523.0f / 32.0f);
+        } else {
+            // HLG reference white is 75% signal: scene light 0.265.
+            float e = linear * 0.265f;
+            out = e <= 1.0f / 12.0f ? sqrtf(3.0f * e)
+                : 0.17883277f * logf(12.0f * e - 0.28466892f) + 0.55991073f;
+        }
+        ctx->pip_osd_lut[i] = lrintf(MPCLAMP(out, 0.0f, 1.0f) * 255.0f);
+    }
+}
+
+// Blend the premultiplied sRGB overlay onto a bgr0/bgra HDR target.
+static void draw_pip_hdr_osd(struct mpv_render_context *ctx, struct osd_state *osd,
+                             double pts, uint8_t *pixels, size_t stride,
+                             int w, int h, enum pl_color_transfer trc)
+{
+    struct sub_bitmap_list *list =
+        osd_render(osd, ctx->pip_osd, pts, 0, mp_draw_sub_formats);
+    if (!list->num_items || list->w != w || list->h != h) {
+        talloc_free(list);
+        return;
+    }
+    if (!ctx->pip_osd_cache)
+        ctx->pip_osd_cache = mp_draw_sub_alloc(ctx, ctx->global);
+    struct mp_rect active[8], modified[8];
+    int num_active = 0, num_modified = 0;
+    struct mp_image *overlay =
+        mp_draw_sub_overlay(ctx->pip_osd_cache, list, active, MP_ARRAY_SIZE(active),
+                            &num_active, modified, MP_ARRAY_SIZE(modified),
+                            &num_modified);
+    if (overlay && overlay->w >= w && overlay->h >= h) {
+        init_pip_osd_lut(ctx, trc);
+        const uint8_t *lut = ctx->pip_osd_lut;
+        for (int n = 0; n < num_active; n++) {
+            struct mp_rect rc = active[n];
+            rc.x0 = MPCLAMP(rc.x0, 0, w);
+            rc.x1 = MPCLAMP(rc.x1, 0, w);
+            rc.y0 = MPCLAMP(rc.y0, 0, h);
+            rc.y1 = MPCLAMP(rc.y1, 0, h);
+            for (int y = rc.y0; y < rc.y1; y++) {
+                const uint8_t *src = overlay->planes[0] + y * overlay->stride[0] + rc.x0 * 4;
+                uint8_t *dst = pixels + y * stride + rc.x0 * 4;
+                for (int x = rc.x0; x < rc.x1; x++, src += 4, dst += 4) {
+                    unsigned a = src[3];
+                    if (!a)
+                        continue;
+                    for (int c = 0; c < 3; c++) {
+                        // Undo premultiplication before the nonlinear mapping.
+                        unsigned straight = a == 255 ? src[c]
+                            : MPMIN(255u, (src[c] * 255u + a / 2) / a);
+                        unsigned mapped = (lut[straight] * a + 127) / 255;
+                        dst[c] = MPMIN(255u, mapped + (dst[c] * (255 - a) + 127) / 255);
+                    }
+                }
+            }
+        }
+    }
+    talloc_free(list);
+}
+
+static int render_pip_sw(struct mpv_render_context *ctx, mpv_render_param *params,
+                          struct vo_frame *frame, struct osd_state *osd)
+{
+    int *size = get_mpv_render_param(params, MPV_RENDER_PARAM_SW_SIZE, NULL);
+    char *format = get_mpv_render_param(params, MPV_RENDER_PARAM_SW_FORMAT, NULL);
+    size_t *stride = get_mpv_render_param(params, MPV_RENDER_PARAM_SW_STRIDE, NULL);
+    void *pixels = get_mpv_render_param(params, MPV_RENDER_PARAM_SW_POINTER, NULL);
+    if (!size && !format && !stride && !pixels)
+        return 0;
+    if (!size || !format || !stride || !pixels || size[0] < 1 || size[1] < 1 ||
+        size[0] > 640 || size[1] > 640 || *stride < size[0] * 4 ||
+        *stride > INT_MAX || (strcmp(format, "bgr0") && strcmp(format, "bgra")))
+        return MPV_ERROR_INVALID_PARAMETER;
+    if (!frame->current)
+        return MPV_ERROR_UNINITIALIZED;
+
+    struct mp_image image;
+    CVPixelBufferRef locked = NULL;
+    int status = map_pip_image(frame->current, &image, &locked);
+    struct mp_image *intermediate = NULL;
+    if (status < 0)
+        goto done;
+    int rotation = image.params.rotate;
+    if (rotation % 90) {
+        status = MPV_ERROR_UNSUPPORTED;
+        goto done;
+    }
+    if (image.params.vflip) {
+        mp_image_vflip(&image);
+        image.params.vflip = false;
+    }
+    image.params.rotate = 0;
+    int width = size[rotation % 180 == 90 ? 1 : 0];
+    int height = size[rotation % 180 == 90 ? 0 : 1];
+
+    if (!ctx->pip_renderer) {
+        ctx->pip_renderer = talloc_zero(ctx, struct render_backend);
+        *ctx->pip_renderer = (struct render_backend) {
+            .global = ctx->global, .log = ctx->log, .fns = &render_backend_sw,
+        };
+        status = ctx->pip_renderer->fns->init(ctx->pip_renderer, (mpv_render_param[]) {
+            { MPV_RENDER_PARAM_API_TYPE, MPV_RENDER_API_TYPE_SW }, {0},
+        });
+        if (status < 0) {
+            ctx->pip_renderer->fns->destroy(ctx->pip_renderer);
+            talloc_free(ctx->pip_renderer->priv);
+            TA_FREEP(&ctx->pip_renderer);
+            goto done;
+        }
+        ctx->pip_pool = mp_image_pool_new(ctx);
+        ctx->pip_opts_cache = m_config_cache_alloc(ctx, ctx->global, &vo_sub_opts);
+    }
+    bool changed = m_config_cache_update(ctx->pip_opts_cache);
+    changed |= !mp_image_params_static_equal(&ctx->pip_params, &image.params) ||
+                ctx->pip_w != width || ctx->pip_h != height ||
+                ctx->pip_rotation != rotation;
+    struct mp_vo_opts *opts = ctx->pip_opts_cache->opts;
+    if (changed) {
+        struct mp_rect src, dst;
+        struct mp_osd_res unrotated_osd;
+        ctx->pip_params = image.params;
+        ctx->pip_w = width;
+        ctx->pip_h = height;
+        ctx->pip_rotation = rotation;
+        ctx->pip_renderer->fns->reconfig(ctx->pip_renderer, &image.params);
+        mp_get_src_dst_rects(ctx->log, opts, 0, &image.params, width, height,
+                            1.0, &src, &dst, &unrotated_osd);
+        ctx->pip_renderer->fns->resize(ctx->pip_renderer, &src, &dst, &unrotated_osd);
+        struct mp_image_params oriented = image.params;
+        oriented.rotate = rotation;
+        mp_get_src_dst_rects(ctx->log, opts, VO_CAP_ROTATE90, &oriented,
+                            size[0], size[1], 1.0, &src, &dst, &ctx->pip_osd);
+    }
+    // Draw subtitles after the image has been rotated, so text stays upright.
+    ctx->pip_renderer->fns->update_external(ctx->pip_renderer, NULL);
+    size_t render_stride = *stride;
+    void *render_pixels = pixels;
+    if (rotation) {
+        intermediate = mp_image_pool_get(ctx->pip_pool, IMGFMT_BGR0, width, height);
+        if (!intermediate) {
+            status = MPV_ERROR_NOMEM;
+            goto done;
+        }
+        render_pixels = intermediate->planes[0];
+        render_stride = intermediate->stride[0];
+    }
+    int render_size[] = { width, height };
+    struct vo_frame software_frame = *frame;
+    software_frame.current = &image;
+    status = ctx->pip_renderer->fns->render(ctx->pip_renderer, (mpv_render_param[]) {
+        { MPV_RENDER_PARAM_SW_SIZE, render_size },
+        { MPV_RENDER_PARAM_SW_FORMAT, format },
+        { MPV_RENDER_PARAM_SW_STRIDE, &render_stride },
+        { MPV_RENDER_PARAM_SW_POINTER, render_pixels }, {0},
+    }, &software_frame);
+    if (status < 0)
+        goto done;
+    if (rotation) {
+        for (int y = 0; y < height; y++) {
+            for (int x = 0; x < width; x++) {
+                int dx = rotation == 90 ? height - 1 - y :
+                         rotation == 180 ? width - 1 - x : y;
+                int dy = rotation == 90 ? x :
+                         rotation == 180 ? height - 1 - y : width - 1 - x;
+                memcpy((uint8_t *)pixels + dy * *stride + dx * 4,
+                       (uint8_t *)render_pixels + y * render_stride + x * 4, 4);
+            }
+        }
+    }
+    // Mode 2: the host presents this frame with the source's HDR transfer.
+    int pip_mode = GET_MPV_RENDER_PARAM(params, MPV_RENDER_PARAM_IOS_PIP_SW, int, 0);
+    enum pl_color_transfer trc = image.params.color.transfer;
+    if (osd && pip_mode == 2 &&
+        (trc == PL_COLOR_TRC_PQ || trc == PL_COLOR_TRC_HLG)) {
+        draw_pip_hdr_osd(ctx, osd, image.pts, pixels, *stride, size[0], size[1], trc);
+    } else if (osd) {
+        struct mp_image target = {0};
+        struct mp_image_params output = {
+            .imgfmt = strcmp(format, "bgra") ? IMGFMT_BGR0 : IMGFMT_BGRA,
+            .w = size[0], .h = size[1],
+        };
+        mp_image_params_guess_csp(&output);
+        mp_image_set_params(&target, &output);
+        target.planes[0] = pixels;
+        target.stride[0] = *stride;
+        osd_draw_on_image(osd, ctx->pip_osd, image.pts, 0, &target);
+    }
+done:
+    talloc_free(intermediate);
+    if (locked)
+        CVPixelBufferUnlockBaseAddress(locked, kCVPixelBufferLock_ReadOnly);
+    return status;
+}
+
+// Called under ctx->lock: retain before releasing the image's vo_frame ref.
+static int retain_pip_frame(struct vo_frame *frame, void **output)
+{
+    *output = NULL;
+    if (!frame || !frame->current)
+        return 0;
+    struct mp_image *image = frame->current;
+    if (image->imgfmt != IMGFMT_VIDEOTOOLBOX || !image->planes[3])
+        return MPV_ERROR_UNSUPPORTED;
+    if (image->params.rotate || image->params.vflip ||
+        (mp_image_crop_valid(&image->params) &&
+         (image->params.crop.x0 || image->params.crop.y0 ||
+          image->params.crop.x1 != image->w || image->params.crop.y1 != image->h)))
+        return MPV_ERROR_UNSUPPORTED;
+    CVPixelBufferRef pixel = (CVPixelBufferRef)image->planes[3];
+    if (CVPixelBufferGetWidth(pixel) != image->w || CVPixelBufferGetHeight(pixel) != image->h)
+        return MPV_ERROR_UNSUPPORTED;
+    *output = CVPixelBufferRetain(pixel);
+    return 0;
+}
