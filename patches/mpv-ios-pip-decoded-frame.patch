+     * existed). Old libraries return NOT_IMPLEMENTED, so hosts must probe
+     * before suppressing GPU rendering or requesting mode 2.
+     */
+    MPV_RENDER_PARAM_IOS_PIP_SW = 26,
 } mpv_render_param_type;
 
