 }
 
+void pl_video_render_overlay(struct pl_video *p, struct vo_frame *frame, pl_tex target_tex)
+{
+    // Subtitle timing and the HDR/SDR tagging of image subtitles depend on
+    // the source frame. Keep it across redraws, which carry no image.
+    if (frame && frame->current && frame->current != p->overlay_src) {
+        talloc_free(p->overlay_src);
+        p->overlay_src = mp_image_new_ref(frame->current);
+        p->last_pts = frame->current->pts;
+    }
+
+    struct pl_frame target_frame = {
+        .num_planes = 1,
+        .planes[0] = { .texture = target_tex, .components = 4, .component_mapping = {0,1,2,3} },
+        .crop = { .x0 = p->current_dst.x0, .y0 = p->current_dst.y0, .x1 = p->current_dst.x1, .y1 = p->current_dst.y1 },
+        .color = pl_color_space_srgb,
+        .repr = pl_color_repr_rgb,
+    };
+    // Core Animation composites this layer over the system-presented video.
+    target_frame.repr.alpha = PL_ALPHA_PREMULTIPLIED;
+
+    update_overlays(p, p->osd_res, 0, PL_OVERLAY_COORDS_DST_FRAME,
+                    &p->osd_state_storage, &target_frame, p->overlay_src);
+
+    // A NULL image clears the whole target and draws only its overlays.
+    struct pl_render_params params = *pl_render_params(
+        .border = PL_CLEAR_COLOR,
+        .background_transparency = 1.0f,
+    );
+    if (!ra_next_render_image(p->ra, NULL, &target_frame, &params))
+        mp_msg(p->log, MSGL_ERR, "Overlay rendering failed.\n");
+}
+
  /**
   * @brief Takes a screenshot of the current video frame.
   * @param ctx The render_backend context.
@@ -1118,6 +1152,7 @@ void pl_video_reset(struct pl_video *p) {
     if (!p || !p->ra) return;
     ra_pl_reset(p->ra);
     ra_next_queue_reset(p->queue); // Also reset the frame queue.
+    TA_FREEP(&p->overlay_src);
     p->last_frame_id = 0;
     p->last_pts = 0;
 }
