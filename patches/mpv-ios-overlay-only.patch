index 62f61a6..a576a53 100755
--- a/include/mpv/render.h
+++ b/include/mpv/render.h
@@ -489,6 +489,22 @@ typedef enum mpv_render_param_type {
      * Type: int*. Use MPV_RENDER_IOSURFACE_COLOR_SPACE_*.
      */
     MPV_RENDER_PARAM_IOSURFACE_COLOR_SPACE = 27,
+    /**
+     * iOS overlay-only rendering for native Dolby Vision presentation.
+     * Valid for MPV_RENDER_API_TYPE_IOSURFACE and mpv_render_context_render().
+     * Type: int*, set to 1. The 32BGRA IOSurface target is cleared to
+     * transparent black and receives only OSD and subtitles, premultiplied
+     * and in sRGB, positioned for the current video rectangle. The video
+     * plane, color adjustments, shaders and tone mapping are skipped. The
+     * frame is consumed with normal presentation timing, so the caller can
+     * fetch the matching decoded frame afterwards with
+     * mpv_render_context_get_info(MPV_RENDER_PARAM_IOS_PIP_FRAME) and present
+     * it itself (for example in an AVSampleBufferDisplayLayer).
+     *
+     * get_info() writes 1 to an int* to indicate support. Old libraries return
+     * NOT_IMPLEMENTED; hosts must probe before relying on this parameter.
+     */
+    MPV_RENDER_PARAM_IOS_OVERLAY_ONLY = 28,
 } mpv_render_param_type;
 
 /** Values for MPV_RENDER_PARAM_IOSURFACE_COLOR_SPACE. */
